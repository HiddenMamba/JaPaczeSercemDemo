{
  "version": 1,
  "directus": "11.17.4",
  "vendor": "postgres",
  "collections": [
    {
      "collection": "cats",
      "meta": { "icon": "pets", "note": "Koty do adopcji", "display_template": "{{name}} ({{status}})", "sort_field": null },
      "schema": { "name": "cats" }
    },
    {
      "collection": "cats_traits",
      "meta": { "icon": "import_export", "hidden": true, "note": "Junction: cats ↔ cat_traits" },
      "schema": { "name": "cats_traits" }
    },
    {
      "collection": "cats_files",
      "meta": { "icon": "photo_library", "hidden": true, "note": "Junction: cats ↔ directus_files (photos)" },
      "schema": { "name": "cats_files" }
    },
    {
      "collection": "cat_traits",
      "meta": { "icon": "star", "note": "Cechy kotów (FIV+, ślepy itp.)", "display_template": "{{label}}", "sort_field": null },
      "schema": { "name": "cat_traits" }
    },
    {
      "collection": "news",
      "meta": { "icon": "article", "note": "Aktualności / wpisy blogowe", "display_template": "{{title}}", "sort_field": null },
      "schema": { "name": "news" }
    },
    {
      "collection": "pages",
      "meta": { "icon": "description", "note": "Statyczne strony CMS (o nas, kontakt)", "display_template": "{{slug}}", "sort_field": null },
      "schema": { "name": "pages" }
    },
    {
      "collection": "documents",
      "meta": { "icon": "folder", "note": "Dokumenty do pobrania (PDF, formularze)", "display_template": "{{name}}", "sort_field": null },
      "schema": { "name": "documents" }
    },
    {
      "collection": "menu_items",
      "meta": { "icon": "menu", "note": "Pozycje menu nawigacyjnego", "display_template": "{{label}} → {{url}}", "sort_field": "order" },
      "schema": { "name": "menu_items" }
    },
    {
      "collection": "social_links",
      "meta": { "icon": "share", "note": "Linki do mediów społecznościowych", "display_template": "{{platform}}: {{url}}", "sort_field": null },
      "schema": { "name": "social_links" }
    },
    {
      "collection": "site_settings",
      "meta": { "icon": "settings", "note": "Ustawienia strony (singleton)", "display_template": "{{site_name}}", "sort_field": null, "singleton": true },
      "schema": { "name": "site_settings" }
    }
  ],
  "fields": [
    { "collection": "cats", "field": "id",            "type": "uuid",    "schema": { "is_primary_key": true }, "meta": { "hidden": true, "readonly": true } },
    { "collection": "cats", "field": "slug",          "type": "string",  "schema": { "is_unique": true, "is_nullable": false }, "meta": { "interface": "input", "note": "Unikalny identyfikator URL, np. whiskers-2024" } },
    { "collection": "cats", "field": "status",        "type": "string",  "schema": { "default_value": "available" }, "meta": { "interface": "select-dropdown", "options": { "choices": [{"text": "Dostępny","value": "available"},{"text": "Zarezerwowany","value": "reserved"},{"text": "Adoptowany","value": "adopted"}] }, "width": "half" } },
    { "collection": "cats", "field": "category",      "type": "string",  "schema": {}, "meta": { "interface": "select-dropdown", "options": { "choices": [{"text": "Kocię (< 1 rok)","value": "kitten"},{"text": "Dorosły (1–7 lat)","value": "adult"},{"text": "Senior (7+ lat)","value": "senior"}] }, "width": "half" } },
    { "collection": "cats", "field": "gender",        "type": "string",  "schema": { "default_value": "unknown" }, "meta": { "interface": "select-dropdown", "options": { "choices": [{"text": "Kocur","value": "male"},{"text": "Kotka","value": "female"},{"text": "Nieznana","value": "unknown"}] }, "width": "half" } },
    { "collection": "cats", "field": "date_of_birth", "type": "date",    "schema": { "is_nullable": true }, "meta": { "interface": "datetime", "width": "half", "note": "Data urodzenia (do obliczenia wieku)" } },
    { "collection": "cats", "field": "name",          "type": "string",  "schema": { "is_nullable": false }, "meta": { "interface": "input" } },
    { "collection": "cats", "field": "description",   "type": "text",    "schema": { "is_nullable": false }, "meta": { "interface": "input-multiline" } },
    { "collection": "cats", "field": "story",         "type": "text",    "schema": { "is_nullable": true }, "meta": { "interface": "input-multiline", "note": "Opcjonalna historia kota" } },
    { "collection": "cats", "field": "photos",        "type": "alias",   "meta": { "interface": "files", "special": ["files"], "note": "Zdjęcia kota — pierwsze jako główne" } },
    { "collection": "cats", "field": "traits",        "type": "alias",   "meta": { "interface": "list-m2m", "special": ["m2m"], "options": { "template": "{{cat_traits_id.label}}" }, "note": "Wybierz cechy kota" } },

    { "collection": "cats_traits", "field": "id",            "type": "integer", "schema": { "is_primary_key": true, "has_auto_increment": true }, "meta": { "hidden": true } },
    { "collection": "cats_traits", "field": "cats_id",       "type": "uuid",    "schema": {}, "meta": { "hidden": true } },
    { "collection": "cats_traits", "field": "cat_traits_id", "type": "uuid",    "schema": {}, "meta": { "hidden": true } },

    { "collection": "cats_files", "field": "id",                 "type": "integer", "schema": { "is_primary_key": true, "has_auto_increment": true }, "meta": { "hidden": true } },
    { "collection": "cats_files", "field": "cats_id",            "type": "uuid",    "schema": {}, "meta": { "hidden": true } },
    { "collection": "cats_files", "field": "directus_files_id",  "type": "uuid",    "schema": {}, "meta": { "hidden": true } },

    { "collection": "cat_traits", "field": "id",    "type": "uuid",   "schema": { "is_primary_key": true, "has_auto_increment": false }, "meta": { "hidden": true, "readonly": true } },
    { "collection": "cat_traits", "field": "icon",  "type": "string", "schema": { "is_nullable": true }, "meta": { "interface": "input", "note": "Emoji lub nazwa ikony, np. 👁️" } },
    { "collection": "cat_traits", "field": "label", "type": "string", "schema": { "is_nullable": false }, "meta": { "interface": "input" } },

    { "collection": "news", "field": "id",           "type": "uuid",      "schema": { "is_primary_key": true }, "meta": { "hidden": true, "readonly": true } },
    { "collection": "news", "field": "slug",         "type": "string",    "schema": { "is_unique": true, "is_nullable": false }, "meta": { "interface": "input" } },
    { "collection": "news", "field": "published_at", "type": "timestamp", "schema": { "is_nullable": true }, "meta": { "interface": "datetime", "width": "half" } },
    { "collection": "news", "field": "cover_image",  "type": "uuid",      "schema": { "is_nullable": true, "foreign_key_table": "directus_files", "foreign_key_column": "id" }, "meta": { "interface": "file-image" } },
    { "collection": "news", "field": "title",        "type": "string",    "schema": { "is_nullable": false }, "meta": { "interface": "input" } },
    { "collection": "news", "field": "body",         "type": "text",      "schema": { "is_nullable": false }, "meta": { "interface": "input-rich-text-html" } },
    { "collection": "news", "field": "excerpt",      "type": "text",      "schema": { "is_nullable": true }, "meta": { "interface": "input-multiline" } },

    { "collection": "pages", "field": "id",      "type": "uuid",   "schema": { "is_primary_key": true }, "meta": { "hidden": true, "readonly": true } },
    { "collection": "pages", "field": "slug",    "type": "string", "schema": { "is_unique": true, "is_nullable": false }, "meta": { "interface": "input", "note": "np. about, contact" } },
    { "collection": "pages", "field": "title",   "type": "string", "schema": { "is_nullable": false }, "meta": { "interface": "input" } },
    { "collection": "pages", "field": "content", "type": "text",   "schema": { "is_nullable": true }, "meta": { "interface": "input-rich-text-html" } },

    { "collection": "documents", "field": "id",       "type": "uuid",   "schema": { "is_primary_key": true }, "meta": { "hidden": true, "readonly": true } },
    { "collection": "documents", "field": "name",     "type": "string", "schema": { "is_nullable": false }, "meta": { "interface": "input" } },
    { "collection": "documents", "field": "file",     "type": "uuid",   "schema": { "is_nullable": false, "foreign_key_table": "directus_files", "foreign_key_column": "id" }, "meta": { "interface": "file", "note": "Prześlij PDF lub dokument" } },
    { "collection": "documents", "field": "category", "type": "string", "schema": { "default_value": "other" }, "meta": { "interface": "select-dropdown", "options": { "choices": [{"text": "Raporty finansowe","value": "financial"},{"text": "Formularze adopcyjne","value": "adoption"},{"text": "Inne","value": "other"}] } } },

    { "collection": "menu_items", "field": "id",              "type": "uuid",    "schema": { "is_primary_key": true }, "meta": { "hidden": true, "readonly": true } },
    { "collection": "menu_items", "field": "label",           "type": "string",  "schema": { "is_nullable": false }, "meta": { "interface": "input" } },
    { "collection": "menu_items", "field": "url",             "type": "string",  "schema": { "is_nullable": false }, "meta": { "interface": "input", "note": "np. /koty lub https://..." } },
    { "collection": "menu_items", "field": "order",           "type": "integer", "schema": { "default_value": 0 }, "meta": { "interface": "input-integer", "width": "half" } },
    { "collection": "menu_items", "field": "open_in_new_tab", "type": "boolean", "schema": { "default_value": false }, "meta": { "interface": "boolean", "width": "half" } },
    { "collection": "menu_items", "field": "parent",          "type": "uuid",    "schema": { "is_nullable": true }, "meta": { "interface": "select-dropdown-m2o", "note": "Zostaw puste dla elementu głównego" } },

    { "collection": "social_links", "field": "id",       "type": "uuid",   "schema": { "is_primary_key": true }, "meta": { "hidden": true, "readonly": true } },
    { "collection": "social_links", "field": "platform", "type": "string", "schema": {}, "meta": { "interface": "select-dropdown", "options": { "choices": [{"text": "Facebook","value": "facebook"},{"text": "Instagram","value": "instagram"},{"text": "Twitter / X","value": "twitter"},{"text": "YouTube","value": "youtube"},{"text": "TikTok","value": "tiktok"}] } } },
    { "collection": "social_links", "field": "url",      "type": "string", "schema": {}, "meta": { "interface": "input" } },
    { "collection": "social_links", "field": "icon",     "type": "string", "schema": { "is_nullable": true }, "meta": { "interface": "input", "note": "Opcjonalna nazwa ikony" } },

    { "collection": "site_settings", "field": "id",                        "type": "uuid",    "schema": { "is_primary_key": true }, "meta": { "hidden": true, "readonly": true } },
    { "collection": "site_settings", "field": "site_name",                 "type": "string",  "schema": { "default_value": "Ja Paczę Sercem" }, "meta": { "interface": "input" } },
    { "collection": "site_settings", "field": "tagline",                   "type": "string",  "schema": { "is_nullable": true }, "meta": { "interface": "input" } },
    { "collection": "site_settings", "field": "logo",                      "type": "uuid",    "schema": { "is_nullable": true, "foreign_key_table": "directus_files", "foreign_key_column": "id" }, "meta": { "interface": "file-image" } },
    { "collection": "site_settings", "field": "banner_enabled",            "type": "boolean", "schema": { "default_value": false }, "meta": { "interface": "boolean" } },
    { "collection": "site_settings", "field": "banner_text",               "type": "string",  "schema": { "is_nullable": true }, "meta": { "interface": "input" } },
    { "collection": "site_settings", "field": "banner_color",              "type": "string",  "schema": { "default_value": "orange" }, "meta": { "interface": "select-dropdown", "options": { "choices": [{"text": "Pomarańczowy","value": "orange"},{"text": "Czerwony","value": "red"},{"text": "Zielony","value": "green"},{"text": "Niebieski","value": "blue"}] } } },
    { "collection": "site_settings", "field": "banner_image",              "type": "uuid",    "schema": { "is_nullable": true, "foreign_key_table": "directus_files", "foreign_key_column": "id" }, "meta": { "interface": "file-image" } },
    { "collection": "site_settings", "field": "founded_year",              "type": "integer", "schema": { "is_nullable": true }, "meta": { "interface": "input-integer" } },
    { "collection": "site_settings", "field": "cats_adopted_before_website","type": "integer", "schema": { "default_value": 0 }, "meta": { "interface": "input-integer" } }
  ],
  "relations": [
    { "collection": "cats_traits", "field": "cats_id",       "related_collection": "cats",       "meta": { "one_field": "traits",  "junction_field": "cat_traits_id" }, "schema": { "on_delete": "CASCADE" } },
    { "collection": "cats_traits", "field": "cat_traits_id", "related_collection": "cat_traits", "meta": { "one_field": null,      "junction_field": "cats_id" },       "schema": { "on_delete": "CASCADE" } },
    { "collection": "cats_files",  "field": "cats_id",           "related_collection": "cats",           "meta": { "one_field": "photos", "junction_field": "directus_files_id" }, "schema": { "on_delete": "CASCADE" } },
    { "collection": "cats_files",  "field": "directus_files_id", "related_collection": "directus_files", "meta": { "one_field": null,     "junction_field": "cats_id" },           "schema": { "on_delete": "CASCADE" } },
    { "collection": "news",         "field": "cover_image", "related_collection": "directus_files", "schema": { "on_delete": "SET NULL" } },
    { "collection": "documents",    "field": "file",        "related_collection": "directus_files", "schema": { "on_delete": "RESTRICT" } },
    { "collection": "site_settings","field": "logo",         "related_collection": "directus_files", "schema": { "on_delete": "SET NULL" } },
    { "collection": "site_settings","field": "banner_image", "related_collection": "directus_files", "schema": { "on_delete": "SET NULL" } },
    { "collection": "menu_items",   "field": "parent",      "related_collection": "menu_items",     "schema": { "on_delete": "SET NULL" } }
  ]
}
