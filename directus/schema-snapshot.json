{
  "version": 1,
  "directus": "11.17.4",
  "vendor": "postgres",
  "collections": [
    {
      "collection": "cats",
      "meta": { "icon": "pets", "note": "Koty do adopcji", "display_template": "{{name}} ({{status}})", "sort_field": null },
      "schema": { "name": "cats" }
    },
    {
      "collection": "cats_traits",
      "meta": { "icon": "import_export", "hidden": true, "note": "Junction: cats ↔ cat_traits" },
      "schema": { "name": "cats_traits" }
    },
    {
      "collection": "cats_files",
      "meta": { "icon": "photo_library", "hidden": true, "note": "Junction: cats ↔ directus_files (photos)" },
      "schema": { "name": "cats_files" }
    },
    {
      "collection": "forever_home_photos",
      "meta": { "icon": "home", "note": "Zdjęcia kotów w domach stałych", "display_template": "{{caption}}", "sort_field": null },
      "schema": { "name": "forever_home_photos" }
    },
    {
      "collection": "cat_traits",
      "meta": { "icon": "star", "note": "Cechy kotów (FIV+, ślepy itp.)", "display_template": "{{label}}", "sort_field": null },
      "schema": { "name": "cat_traits" }
    },
    {
      "collection": "news",
      "meta": { "icon": "article", "note": "Aktualności / wpisy blogowe", "display_template": "{{title}}", "sort_field": null },
      "schema": { "name": "news" }
    },
    {
      "collection": "pages",
      "meta": { "icon": "description", "note": "Statyczne strony CMS (o nas, kontakt)", "display_template": "{{slug}}", "sort_field": null },
      "schema": { "name": "pages" }
    },
    {
      "collection": "documents",
      "meta": { "icon": "folder", "note": "Dokumenty do pobrania (PDF, formularze)", "display_template": "{{name}}", "sort_field": null },
      "schema": { "name": "documents" }
    },
    {
      "collection": "menu_items",
      "meta": { "icon": "menu", "note": "Pozycje menu nawigacyjnego", "display_template": "{{label}} → {{url}}", "sort_field": "order" },
      "schema": { "name": "menu_items" }
    },
    {
      "collection": "social_links",
      "meta": { "icon": "share", "note": "Linki do mediów społecznościowych", "display_template": "{{platform}}: {{url}}", "sort_field": null },
      "schema": { "name": "social_links" }
    },
    {
      "collection": "support_methods",
      "meta": { "icon": "favorite", "note": "Sposoby wsparcia fundacji (przelewy, linki, opisy)", "display_template": "{{title}}", "sort_field": "order" },
      "schema": { "name": "support_methods" }
    },
    {
      "collection": "partners",
      "meta": { "icon": "handshake", "note": "Partnerzy i sponsorzy", "display_template": "{{name}}", "sort_field": "order" },
      "schema": { "name": "partners" }
    },
    {
      "collection": "adoption_questions",
      "meta": { "icon": "help", "note": "Pytania w formularzu adopcyjnym", "display_template": "{{question}}", "sort_field": "order" },
      "schema": { "name": "adoption_questions" }
    },
    {
      "collection": "site_settings",
      "meta": { "icon": "settings", "note": "Ustawienia strony (singleton)", "display_template": "{{site_name}}", "sort_field": null, "singleton": true },
      "schema": { "name": "site_settings" }
    },
    {
      "collection": "page_style",
      "meta": { "icon": "palette", "note": "Styl strony – kolory i podstawowa typografia (singleton)", "display_template": "Styl strony", "sort_field": null, "singleton": true, "translations": [{"language":"pl-PL","translation":"Styl strony"}] },
      "schema": { "name": "page_style" }
    }
  ],
  "fields": [
    { "collection": "cats", "field": "id",            "type": "uuid",    "schema": { "is_primary_key": true }, "meta": { "hidden": true, "readonly": true, "special": ["uuid"] } },
    { "collection": "cats", "field": "slug",          "type": "string",  "schema": { "is_unique": true, "is_nullable": false }, "meta": { "interface": "input", "note": "Unikalny identyfikator URL, np. whiskers-2024", "translations": [{"language":"pl-PL","translation":"URL"}] } },
    { "collection": "cats", "field": "status",        "type": "string",  "schema": { "default_value": "available" }, "meta": { "interface": "select-dropdown", "display": "labels", "options": { "choices": [{"text": "Dostępny","value": "available"},{"text": "W trakcie leczenia","value": "inTreatment"},{"text": "Adoptowany","value": "adopted"},{"text": "Za tęczowym mostem","value": "rainbow"}] }, "width": "half", "translations": [{"language":"pl-PL","translation":"Status"}] } },
    { "collection": "cats", "field": "category",      "type": "string",  "schema": {}, "meta": { "interface": "select-dropdown", "display": "labels", "options": { "choices": [{"text": "Kocię","value": "kitten"},{"text": "Dorosły","value": "adult"},{"text": "Senior","value": "senior"}] }, "width": "half", "note": "Używany tylko, gdy nie podano daty urodzenia. Jeśli data urodzenia jest ustawiona, kategoria jest obliczana automatycznie.", "translations": [{"language":"pl-PL","translation":"Kategoria wiekowa"}] } },
    { "collection": "cats", "field": "gender",        "type": "string",  "schema": { "default_value": "unknown" }, "meta": { "interface": "select-dropdown", "display": "labels", "options": { "choices": [{"text": "Samiec","value": "male"},{"text": "Samica","value": "female"},{"text": "Nieznana","value": "unknown"}] }, "width": "half", "translations": [{"language":"pl-PL","translation":"Płeć"}] } },
    { "collection": "cats", "field": "date_of_birth", "type": "date",    "schema": { "is_nullable": true }, "meta": { "interface": "datetime", "width": "half", "note": "Data urodzenia (do obliczenia wieku)", "translations": [{"language":"pl-PL","translation":"Data urodzenia"}] } },
    { "collection": "cats", "field": "name",          "type": "string",  "schema": { "is_nullable": false }, "meta": { "interface": "input", "translations": [{"language":"pl-PL","translation":"Imię"}] } },
    { "collection": "cats", "field": "description",   "type": "text",    "schema": { "is_nullable": false }, "meta": { "interface": "input-multiline", "translations": [{"language":"pl-PL","translation":"Opis"}] } },
    { "collection": "cats", "field": "story",         "type": "text",    "schema": { "is_nullable": true }, "meta": { "interface": "input-multiline", "note": "Opcjonalna historia kota", "translations": [{"language":"pl-PL","translation":"Historia"}] } },
    { "collection": "cats", "field": "date_joined",    "type": "date",    "schema": { "is_nullable": true }, "meta": { "interface": "datetime", "width": "half", "note": "Data dołączenia kota do fundacji", "translations": [{"language":"pl-PL","translation":"Data dołączenia"}] } },
    { "collection": "cats", "field": "photos",        "type": "alias",   "meta": { "interface": "files", "special": ["files"], "note": "Zdjęcia kota - pierwsze jako główne", "translations": [{"language":"pl-PL","translation":"Zdjęcia"}] } },
    { "collection": "cats", "field": "traits",        "type": "alias",   "meta": { "interface": "list-m2m", "special": ["m2m"], "options": { "template": "{{cat_traits_id.label}}" }, "note": "Wybierz cechy kota", "translations": [{"language":"pl-PL","translation":"Cechy szczególne"}] } },

    { "collection": "cats_traits", "field": "id",            "type": "integer", "schema": { "is_primary_key": true, "has_auto_increment": true }, "meta": { "hidden": true } },
    { "collection": "cats_traits", "field": "cats_id",       "type": "uuid",    "schema": {}, "meta": { "hidden": true } },
    { "collection": "cats_traits", "field": "cat_traits_id", "type": "uuid",    "schema": {}, "meta": { "hidden": true } },

    { "collection": "cats_files", "field": "id",                 "type": "integer", "schema": { "is_primary_key": true, "has_auto_increment": true }, "meta": { "hidden": true } },
    { "collection": "cats_files", "field": "cats_id",            "type": "uuid",    "schema": {}, "meta": { "hidden": true } },
    { "collection": "cats_files", "field": "directus_files_id",  "type": "uuid",    "schema": {}, "meta": { "hidden": true } },

    { "collection": "forever_home_photos", "field": "id",           "type": "uuid",      "schema": { "is_primary_key": true }, "meta": { "hidden": true, "readonly": true, "special": ["uuid"] } },
    { "collection": "forever_home_photos", "field": "cat",          "type": "uuid",      "schema": { "is_nullable": true, "foreign_key_table": "cats", "foreign_key_column": "id" }, "meta": { "interface": "select-dropdown-m2o", "width": "half", "translations": [{"language":"pl-PL","translation":"Kot"}] } },
    { "collection": "forever_home_photos", "field": "photo",        "type": "uuid",      "schema": { "is_nullable": true, "foreign_key_table": "directus_files", "foreign_key_column": "id" }, "meta": { "interface": "file-image", "width": "half", "translations": [{"language":"pl-PL","translation":"Zdjęcie"}] } },
    { "collection": "forever_home_photos", "field": "caption",      "type": "string",    "schema": { "is_nullable": true }, "meta": { "interface": "input", "translations": [{"language":"pl-PL","translation":"Podpis"}] } },
    { "collection": "forever_home_photos", "field": "published_at", "type": "timestamp", "schema": { "is_nullable": true }, "meta": { "interface": "datetime", "width": "half", "translations": [{"language":"pl-PL","translation":"Data publikacji"}] } },

    { "collection": "cat_traits", "field": "id",    "type": "uuid",   "schema": { "is_primary_key": true, "has_auto_increment": false }, "meta": { "hidden": true, "readonly": true, "special": ["uuid"] } },
    { "collection": "cat_traits", "field": "icon",  "type": "string", "schema": { "is_nullable": true }, "meta": { "interface": "select-dropdown", "options": { "choices": [{"text":"🐾 Ogólne","value":"🐾"},{"text":"❤️ Łagodny","value":"❤️"},{"text":"⭐ Wyjątkowy","value":"⭐"},{"text":"🏠 Tylko dom","value":"🏠"},{"text":"🌿 Spokojny","value":"🌿"},{"text":"👁️ Jednooki","value":"👁️"},{"text":"🦯 Ślepy","value":"🦯"},{"text":"🔇 Głuchy","value":"🔇"},{"text":"🦠 FIV+","value":"🦠"},{"text":"🩸 FeLV+","value":"🩸"},{"text":"💊 Leczenie przewlekłe","value":"💊"},{"text":"🍽️ Dieta specjalna","value":"🍽️"},{"text":"🏥 Po operacji","value":"🏥"},{"text":"🩺 Pod opieką wet.","value":"🩺"},{"text":"♀️ Kotka","value":"♀️"},{"text":"♂️ Kocur","value":"♂️"},{"text":"👶 Przyjazny dzieciom","value":"👶"},{"text":"🐶 Przyjazny psom","value":"🐶"},{"text":"🐱 Przyjazny kotom","value":"🐱"},{"text":"🫣 Nieśmiały","value":"🫣"},{"text":"🌈 Za tęczowym mostem","value":"🌈"},{"text":"🎀 Senior","value":"🎀"},{"text":"🐣 Kocię","value":"🐣"},{"text":"🛋️ Kanapowiec","value":"🛋️"},{"text":"🌙 Nocny marek","value":"🌙"},{"text":"🎾 Aktywny","value":"🎾"},{"text":"🤗 Towarzyski","value":"🤗"},{"text":"😿 Wymaga cierpliwości","value":"😿"},{"text":"✂️ Wykastrowany","value":"✂️"},{"text":"💉 Szczepiony","value":"💉"},{"text":"🏷️ Zaczipowany","value":"🏷️"}], "allowOther": true }, "note": "Wybierz emoji z listy lub wpisz własne", "width": "half", "translations": [{"language":"pl-PL","translation":"Ikona (emoji)"}] } },
    { "collection": "cat_traits", "field": "label", "type": "string", "schema": { "is_nullable": false }, "meta": { "interface": "input" } },

    { "collection": "news", "field": "id",           "type": "uuid",      "schema": { "is_primary_key": true }, "meta": { "hidden": true, "readonly": true, "special": ["uuid"] } },
    { "collection": "news", "field": "slug",         "type": "string",    "schema": { "is_unique": true, "is_nullable": false }, "meta": { "interface": "input" } },
    { "collection": "news", "field": "published_at", "type": "timestamp", "schema": { "is_nullable": true }, "meta": { "interface": "datetime", "width": "half" } },
    { "collection": "news", "field": "cover_image",  "type": "uuid",      "schema": { "is_nullable": true, "foreign_key_table": "directus_files", "foreign_key_column": "id" }, "meta": { "interface": "file-image" } },
    { "collection": "news", "field": "title",        "type": "string",    "schema": { "is_nullable": false }, "meta": { "interface": "input" } },
    { "collection": "news", "field": "body",         "type": "text",      "schema": { "is_nullable": false }, "meta": { "interface": "input-rich-text-html" } },
    { "collection": "news", "field": "excerpt",      "type": "text",      "schema": { "is_nullable": true }, "meta": { "interface": "input-multiline" } },

    { "collection": "pages", "field": "id",      "type": "uuid",   "schema": { "is_primary_key": true }, "meta": { "hidden": true, "readonly": true, "special": ["uuid"] } },
    { "collection": "pages", "field": "slug",    "type": "string", "schema": { "is_unique": true, "is_nullable": false }, "meta": { "interface": "input", "note": "np. about, contact" } },
    { "collection": "pages", "field": "title",   "type": "string", "schema": { "is_nullable": false }, "meta": { "interface": "input" } },
    { "collection": "pages", "field": "content", "type": "text",   "schema": { "is_nullable": true }, "meta": { "interface": "input-rich-text-html" } },

    { "collection": "documents", "field": "id",       "type": "uuid",   "schema": { "is_primary_key": true }, "meta": { "hidden": true, "readonly": true, "special": ["uuid"] } },
    { "collection": "documents", "field": "name",     "type": "string", "schema": { "is_nullable": false }, "meta": { "interface": "input" } },
    { "collection": "documents", "field": "file",     "type": "uuid",   "schema": { "is_nullable": false, "foreign_key_table": "directus_files", "foreign_key_column": "id" }, "meta": { "interface": "file", "note": "Prześlij PDF lub dokument" } },
    { "collection": "documents", "field": "category", "type": "string", "schema": { "default_value": "other" }, "meta": { "interface": "select-dropdown", "options": { "choices": [{"text": "Raporty finansowe","value": "financial"},{"text": "Formularze adopcyjne","value": "adoption"},{"text": "Inne","value": "other"}] } } },

    { "collection": "menu_items", "field": "id",              "type": "uuid",    "schema": { "is_primary_key": true }, "meta": { "hidden": true, "readonly": true, "special": ["uuid"] } },
    { "collection": "menu_items", "field": "label",           "type": "string",  "schema": { "is_nullable": false }, "meta": { "interface": "input" } },
    { "collection": "menu_items", "field": "url",             "type": "string",  "schema": { "is_nullable": false }, "meta": { "interface": "input", "note": "np. /koty lub https://..." } },
    { "collection": "menu_items", "field": "order",           "type": "integer", "schema": { "default_value": 0 }, "meta": { "interface": "input-integer", "width": "half" } },
    { "collection": "menu_items", "field": "open_in_new_tab", "type": "boolean", "schema": { "default_value": false }, "meta": { "interface": "boolean", "width": "half" } },
    { "collection": "menu_items", "field": "parent",          "type": "string",  "schema": { "is_nullable": true }, "meta": { "interface": "input", "note": "ID rodzica (opcjonalne)" } },

    { "collection": "social_links", "field": "id",       "type": "uuid",   "schema": { "is_primary_key": true }, "meta": { "hidden": true, "readonly": true, "special": ["uuid"] } },
    { "collection": "social_links", "field": "platform", "type": "string", "schema": {}, "meta": { "interface": "select-dropdown", "options": { "choices": [{"text": "Facebook","value": "facebook"},{"text": "Instagram","value": "instagram"},{"text": "Twitter / X","value": "twitter"},{"text": "YouTube","value": "youtube"},{"text": "TikTok","value": "tiktok"},{"text": "LinkedIn","value": "linkedin"},{"text": "Inne","value": "other"}], "allowOther": true }, "note": "Wybierz lub wpisz własną platformę" } },
    { "collection": "social_links", "field": "url",      "type": "string", "schema": {}, "meta": { "interface": "input" } },
    { "collection": "social_links", "field": "icon",     "type": "string", "schema": { "is_nullable": true }, "meta": { "interface": "input", "note": "Emoji ikony, np. 📘 🐦 💼 - zostaw puste dla domyślnej ikony platformy", "width": "half" } },
    { "collection": "social_links", "field": "color",    "type": "string", "schema": { "is_nullable": true }, "meta": { "interface": "select-color", "note": "Kolor tła przycisku - zostaw puste dla domyślnego koloru platformy", "width": "half" } },
    { "collection": "social_links", "field": "image",    "type": "uuid",   "schema": { "is_nullable": true, "foreign_key_table": "directus_files", "foreign_key_column": "id" }, "meta": { "interface": "file-image", "note": "Opcjonalne logo/obrazek zamiast emoji (np. logo marki)" } },

    { "collection": "support_methods", "field": "id",          "type": "uuid",    "schema": { "is_primary_key": true }, "meta": { "hidden": true, "readonly": true, "special": ["uuid"] } },
    { "collection": "support_methods", "field": "title",       "type": "string",  "schema": { "is_nullable": false }, "meta": { "interface": "input", "note": "np. Przelew bankowy, Zbiórka online, Darowizna rzeczowa" } },
    { "collection": "support_methods", "field": "type",        "type": "string",  "schema": { "default_value": "info" }, "meta": { "interface": "select-dropdown", "options": { "choices": [{"text":"Informacja","value":"info"},{"text":"Numer konta","value":"account"},{"text":"Link zewnętrzny","value":"link"},{"text":"Zrzutka/Patronite","value":"crowdfunding"}] } } },
    { "collection": "support_methods", "field": "description", "type": "text",    "schema": { "is_nullable": true }, "meta": { "interface": "input-rich-text-html", "note": "Opis sposobu wsparcia (może zawierać numery kont, instrukcje itp.)" } },
    { "collection": "support_methods", "field": "url",         "type": "string",  "schema": { "is_nullable": true }, "meta": { "interface": "input", "note": "Link do zbiórki, Patronite itp. (opcjonalny)" } },
    { "collection": "support_methods", "field": "button_label","type": "string",  "schema": { "is_nullable": true }, "meta": { "interface": "input", "note": "Tekst przycisku, np. 'Wesprzyj na Patronite'" } },
    { "collection": "support_methods", "field": "icon",        "type": "string",  "schema": { "is_nullable": true }, "meta": { "interface": "input", "note": "Emoji ikony, np. 🏦 💳 ❤️" } },
    { "collection": "support_methods", "field": "order",       "type": "integer", "schema": { "default_value": 0 }, "meta": { "interface": "input-integer", "width": "half" } },
    { "collection": "support_methods", "field": "active",      "type": "boolean", "schema": { "default_value": true }, "meta": { "interface": "boolean", "width": "half" } },

    { "collection": "partners", "field": "id",          "type": "uuid",    "schema": { "is_primary_key": true }, "meta": { "hidden": true, "readonly": true, "special": ["uuid"] } },
    { "collection": "partners", "field": "name",        "type": "string",  "schema": { "is_nullable": false }, "meta": { "interface": "input", "translations": [{"language":"pl-PL","translation":"Nazwa"}] } },
    { "collection": "partners", "field": "url",         "type": "string",  "schema": { "is_nullable": true }, "meta": { "interface": "input", "note": "Link do strony partnera", "translations": [{"language":"pl-PL","translation":"Strona WWW"}] } },
    { "collection": "partners", "field": "logo",        "type": "uuid",    "schema": { "is_nullable": true, "foreign_key_table": "directus_files", "foreign_key_column": "id" }, "meta": { "interface": "file-image", "translations": [{"language":"pl-PL","translation":"Logo"}] } },
    { "collection": "partners", "field": "description", "type": "text",    "schema": { "is_nullable": true }, "meta": { "interface": "input-multiline", "note": "Krótki opis partnera (opcjonalny)", "translations": [{"language":"pl-PL","translation":"Opis"}] } },
    { "collection": "partners", "field": "order",       "type": "integer", "schema": { "default_value": 0 }, "meta": { "interface": "input-integer", "width": "half", "translations": [{"language":"pl-PL","translation":"Kolejność"}] } },
    { "collection": "partners", "field": "active",      "type": "boolean", "schema": { "default_value": true }, "meta": { "interface": "boolean", "width": "half", "translations": [{"language":"pl-PL","translation":"Aktywny"}] } },

    { "collection": "adoption_questions", "field": "id",          "type": "uuid",    "schema": { "is_primary_key": true }, "meta": { "hidden": true, "readonly": true, "special": ["uuid"] } },
    { "collection": "adoption_questions", "field": "question",    "type": "string",  "schema": { "is_nullable": false }, "meta": { "interface": "input" } },
    { "collection": "adoption_questions", "field": "field_type",  "type": "string",  "schema": { "default_value": "text" }, "meta": { "interface": "select-dropdown", "options": { "choices": [{"text":"Tekst","value":"text"},{"text":"Długi tekst","value":"textarea"},{"text":"Jednokrotny wybór","value":"radio"},{"text":"Wielokrotny wybór","value":"multiselect"}] } } },
    { "collection": "adoption_questions", "field": "options",     "type": "json",    "schema": { "is_nullable": true }, "meta": { "interface": "input-code", "options": { "language": "json", "placeholder": "[{\"label\":\"Opcja 1\",\"value\":\"opcja_1\"},{\"label\":\"Opcja 2\",\"value\":\"opcja_2\"}]" }, "note": "JSON: [{\"label\":\"Tekst\",\"value\":\"wartosc\"}]", "special": ["cast-json"] } },
    { "collection": "adoption_questions", "field": "required",    "type": "boolean", "schema": { "default_value": true }, "meta": { "interface": "boolean", "width": "half" } },
    { "collection": "adoption_questions", "field": "active",      "type": "boolean", "schema": { "default_value": true }, "meta": { "interface": "boolean", "width": "half" } },
    { "collection": "adoption_questions", "field": "order",       "type": "integer", "schema": { "default_value": 0 }, "meta": { "interface": "input-integer", "width": "half" } },
    { "collection": "adoption_questions", "field": "placeholder", "type": "string",  "schema": { "is_nullable": true }, "meta": { "interface": "input", "width": "half" } },

    { "collection": "page_style", "field": "id",             "type": "uuid",   "schema": { "is_primary_key": true }, "meta": { "hidden": true, "readonly": true, "special": ["uuid"] } },
    { "collection": "page_style", "field": "primary_color",  "type": "string", "schema": { "is_nullable": true }, "meta": { "interface": "select-color", "note": "Główny kolor marki – przyciski, akcenty (domyślnie: #eb5e28)", "width": "half", "translations": [{"language":"pl-PL","translation":"Kolor główny"}] } },
