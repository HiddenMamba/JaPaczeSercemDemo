# ── Copy to .env on your VPS and fill in all values ──────────────────────────
# Never commit the actual .env file!

# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=yourcatscharity.org
SITE_NAME=Meow Haven

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=catadoption
POSTGRES_USER=directus
POSTGRES_PASSWORD=change_me_strong_password_here

# ── Directus ──────────────────────────────────────────────────────────────────
DIRECTUS_SECRET=change_me_random_64_char_string_here
DIRECTUS_ADMIN_EMAIL=admin@yourcatscharity.org
DIRECTUS_ADMIN_PASSWORD=change_me_strong_admin_password
# Generate a static token in Directus admin → Users → your account → Token
DIRECTUS_TOKEN=change_me_static_api_token

# ── Email (Resend - free 3000/month) ─────────────────────────────────────────
# Sign up at https://resend.com and verify your domain
RESEND_API_KEY=re_your_key_here
CONTACT_EMAIL=hello@yourcatscharity.org
